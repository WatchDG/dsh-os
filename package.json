{
  "name": "dsh-os",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "OS and shell awareness for DeepSeek Harness agents: detect the machine, switch the target OS and shell, and inject the matching terminal rules.",
  "license": "Apache-2.0",
  "author": "Baranov Grigoriy Vladimirovich",
  "homepage": "https://github.com/WatchDG/dsh-os#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatchDG/dsh-os.git"
  },
  "bugs": {
    "url": "https://github.com/WatchDG/dsh-os/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "os",
    "shell",
    "terminal",
    "powershell",
    "bash",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "topics/*.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/env.test.mjs test/rules.test.mjs test/plugin.test.mjs test/status.test.mjs test/topics.test.mjs test/manifest.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
